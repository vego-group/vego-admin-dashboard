# ──────────────────────────────────────────────────────────────────────────────
# MyVego Fleet Dashboard — environment variables
#
# Copy this file to .env.local and fill in the real values.
# Variables starting with NEXT_PUBLIC_ are exposed to the browser.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash).
# All fleet-admin requests are prefixed automatically:
#   e.g. https://api.myvego.com/api  →  https://api.myvego.com/api/fleet-admin/dashboard
NEXT_PUBLIC_API_URL=https://api.myvego.com/api

# CARTO basemaps API key for the Leaflet maps (src/lib/map-tiles.ts).
# Set only in Vercel's environment — never commit a key. It is inlined at build
# time, so a change applies from the next deploy. Empty (or the old placeholder
# "your-map-tiles-key") → the maps fall back to OpenStreetMap's standard tiles.
NEXT_PUBLIC_MAP_TILES_KEY=
